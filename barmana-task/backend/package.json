{
  "name": "barmana-task-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:setup": "node scripts/setupDatabase.js",
    "check": "node --check src/server.js && node --check scripts/migrateDatabase.js && node --check scripts/seedDatabase.js",
    "start:prod": "npm run db:migrate && npm run db:seed && node src/server.js",
    "db:migrate": "node scripts/migrateDatabase.js",
    "db:seed": "node scripts/seedDatabase.js",
    "test:smoke": "node scripts/smokeTest.js",
    "reports:daily": "node scripts/generateDailyProjectReports.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
